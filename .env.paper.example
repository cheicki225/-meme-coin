# Secret-free PAPER example. This file contains no credentials and is not loaded automatically.
# Copy to a local .env only for an explicitly authorized PAPER environment.
TRADING_MODE=PAPER
LIVE_EXECUTION_ENABLED=false
JITO_ENABLED=false

# Read-only provider inputs are intentionally empty.
SOLANA_RPC_URL=
HELIUS_API_KEY=
ALCHEMY_API_KEY=
GOPLUS_API_KEY=
GOPLUS_API_SECRET=
GMGN_API_KEY=
MOBULA_API_KEY=
SOLSCAN_API_KEY=
JUPITER_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
TELEGRAM_BOT_TOKEN=
BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# No signing wallet or encryption key is configured.
SOLANA_PRIVATE_KEY=
WALLET_ENCRYPTION_KEY=

# Conservative local defaults; confirm a provider plan's actual quotas before any read-only soak.
SOLANA_RPC_REQUESTS_PER_SECOND=3
HELIUS_ENHANCED_REQUESTS_PER_SECOND=1
HELIUS_EVENT_QUEUE_MAX_PENDING=10000
HELIUS_EVENT_QUEUE_MAX_BYTES=33554432
HELIUS_EVENT_RETRY_BASE_S=1
HELIUS_EVENT_RETRY_MAX_S=60
